# Lead Finder configuration. Copy to your secret store / environment; never commit real keys.
# Every provider is optional: a missing key shows "Not Configured" and nothing is substituted for it.

LEAD_FINDER_DB=lead_finder.db

# Wallet discovery, holdings, activity, labels (https://api.nansen.ai, header: apiKey)
NANSEN_API_KEY=

# Ethereum JSON-RPC endpoint for ENS reverse/forward resolution (wallet -> person attribution)
ETH_RPC_URL=

# Contact enrichment: Apollo first, Hunter as fallback and for email verification
APOLLO_API_KEY=
HUNTER_API_KEY=

# Optional: raises GitHub's public API rate limit for profile lookups
GITHUB_TOKEN=

# Optional: JSON {chain: [token_address, ...]} used to discover active wallets via Nansen who-bought-sold
# LEAD_FINDER_SEED_TOKENS={"ethereum":["0xC02aaA39b223FE8D0A0e5C4F27eAD9083C756Cc2"]}
# LEAD_FINDER_MAX_CANDIDATES=25
# LEAD_FINDER_FETCH_WEBSITES=true
# Set to false only for local http:// development; keep true behind HTTPS
# LEAD_FINDER_COOKIE_SECURE=true
