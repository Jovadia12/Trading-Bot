# Copy to a file named .env in the repo root (git-ignored) and fill in locally.
# NEVER commit the filled-in file. NEVER paste the secret into chat or logs.

# Mandatory safety gate. The application refuses to start unless this is exactly "true".
PAPER_MODE=true

# Coinbase Developer Platform (CDP) API key. Create a VIEW-ONLY key (no Trade, no Transfer).
# Key name, e.g. organizations/<org_id>/apiKeys/<key_id>  (or the key ID shown by the CDP portal)
COINBASE_API_KEY=
# Ed25519 private key as downloaded from the CDP portal (base64), or a PEM block with \n escapes.
COINBASE_API_SECRET=

# Optional: only if you knowingly use a key that has the Trade permission. Orders are still
# impossible in this codebase; this only downgrades the startup refusal to a warning.
# ALLOW_TRADE_SCOPED_KEY=false
